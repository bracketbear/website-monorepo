---
import Layout from '@/layouts/Layout.astro';
import Section from '@/components/Section.astro';
import { getCollection } from 'astro:content';
import { Button } from '@bracketbear/bear-ui-react';
import { marked } from 'marked';

// Get the about page content from CMS
const aboutPageData = await getCollection('bracketbearAboutPage');
const pageData = aboutPageData[0]?.data;

if (!pageData) {
  throw new Error('About page content not found');
}
---

<Layout title={pageData.title}>
  <!-- Hero Section -->
  <section class="px-content py-16 lg:py-24">
    <div class="container mx-auto text-center">
      <h1
        class="font-heading text-foreground mb-8 text-4xl font-bold tracking-tight uppercase lg:text-6xl"
      >
        {pageData.hero.title}
      </h1>
      <p
        class="text-muted-foreground mx-auto max-w-4xl text-lg leading-7 lg:text-xl"
      >
        {pageData.hero.subtitle}
      </p>
    </div>
  </section>

  <!-- Our Story Section -->
  <Section title={pageData.ourStory.title}>
    <div
      class="text-muted-foreground text-lg leading-7"
      set:html={marked.parse(pageData.ourStory.content)}
    />
  </Section>

  <!-- Philosophy Section -->
  <Section title={pageData.philosophy.title}>
    <h3
      class="font-heading text-foreground mb-6 text-xl font-bold tracking-tight"
    >
      {pageData.philosophy.subtitle}
    </h3>
    <div
      class="text-muted-foreground text-lg leading-7"
      set:html={marked.parse(pageData.philosophy.content)}
    />
  </Section>

  <!-- Core Values Section -->
  <Section title={pageData.coreValues.title}>
    <h3
      class="font-heading text-foreground mb-12 text-center text-xl font-bold tracking-tight"
    >
      {pageData.coreValues.subtitle}
    </h3>
    <div class="grid gap-8 lg:grid-cols-3">
      {
        pageData.coreValues.values.map((value: any) => (
          <div class="comic-panel">
            <h4 class="font-heading text-foreground mb-4 text-xl font-bold tracking-tight">
              {value.title}
            </h4>
            <div
              class="text-muted-foreground prose prose-lg max-w-none"
              set:html={marked.parse(value.description)}
            />
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Who We Are Section -->
  <Section title={pageData.whoWeAre.title}>
    <div
      class="text-muted-foreground text-lg leading-7"
      set:html={marked.parse(pageData.whoWeAre.content)}
    />
  </Section>

  <!-- CTA Section -->
  <section class="px-content py-12 lg:py-16">
    <div class="container mx-auto text-center">
      <div class="prose prose-lg mx-auto max-w-prose">
        <div
          class="text-foreground mb-8 text-lg leading-7"
          set:html={marked.parse(pageData.contactCTA.text)}
        />
        <Button
          href={pageData.contactCTA.buttonLink}
          size="lg"
          className="font-semibold"
        >
          {pageData.contactCTA.buttonText}
        </Button>
      </div>
    </div>
  </section>
</Layout>
