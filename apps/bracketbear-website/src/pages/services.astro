---
import Layout from '@/layouts/Layout.astro';
import Section from '@/components/Section.astro';
import { getCollection } from 'astro:content';
import { Button } from '@bracketbear/bear-ui-react';
import { marked } from 'marked';

// Get the services page content from CMS
const servicesPageData = await getCollection('bracketbearServicesPage');
const pageData = servicesPageData[0]?.data;

if (!pageData) {
  throw new Error('Services page content not found');
}
---

<Layout title={pageData.title}>
  <!-- Hero Section -->
  <section class="px-content py-16 lg:py-24">
    <div class="container mx-auto text-center">
      <h1
        class="font-heading text-foreground mb-8 text-4xl font-bold tracking-tight uppercase lg:text-6xl"
      >
        {pageData.hero.title}
      </h1>
      <p
        class="text-muted-foreground mx-auto max-w-4xl text-lg leading-7 lg:text-xl"
      >
        {pageData.hero.subtitle}
      </p>
    </div>
  </section>

  <!-- Intro Section -->
  <Section title={pageData.intro.title}>
    <div
      class="text-muted-foreground text-lg leading-7"
      set:html={marked.parse(pageData.intro.content)}
    />
  </Section>

  <!-- Service Modes Section -->
  <Section title="Our Three Modes of Service">
    <div class="grid gap-8 lg:grid-cols-1">
      {
        pageData.serviceModes.map((service: any) => (
          <div class="comic-panel">
            <h3 class="font-heading text-foreground mb-6 text-2xl font-bold tracking-tight">
              {service.title}
            </h3>
            <div
              class="text-muted-foreground prose prose-lg max-w-none"
              set:html={marked.parse(service.description)}
            />
          </div>
        ))
      }
    </div>
  </Section>

  <!-- CTA Section -->
  <section class="px-content py-12 lg:py-16">
    <div class="container mx-auto text-center">
      <div class="prose prose-lg mx-auto max-w-prose">
        <div
          class="text-foreground mb-8 text-lg leading-7"
          set:html={marked.parse(pageData.contactCTA.text)}
        />
        <Button
          href={pageData.contactCTA.buttonLink}
          size="lg"
          className="font-semibold"
        >
          {pageData.contactCTA.buttonText}
        </Button>
      </div>
    </div>
  </section>
</Layout>
