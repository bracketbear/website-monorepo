---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { meta, notFound } from '@/content/site/not-found';
---

<SiteLayout meta={meta} path="/404" noindex>
  <section class="section">
    <div class="section__inner">
      <h1 class="headline">{notFound.headline}</h1>
      <p>
        <a class="btn btn--primary" href={notFound.link.href}
          >{notFound.link.label}</a
        >
      </p>
    </div>
  </section>
</SiteLayout>
