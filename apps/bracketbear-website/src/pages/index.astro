---
import HomeLayout from '@/layouts/HomeLayout.astro';
import Section from '@/components/Section.astro';
import { getCollection } from 'astro:content';
import { Button } from '@bracketbear/bear-ui-react';
import { HeroSection } from '@/components/HeroSection';
import { marked } from 'marked';

// Get the homepage content from CMS
const indexPageData = await getCollection('bracketbearIndexPage');
const pageData = indexPageData[0]?.data;

if (!pageData) {
  throw new Error('Homepage content not found');
}
---

<HomeLayout
  title={pageData.title}
  hideContactForm={false}
  metaDescription={pageData.metaDescription || pageData.hero.subtitle}
  currentPage="home"
>
  <!-- Hero Section with Particle Animation -->
  <HeroSection
    className="w-full"
    client:load
    preset="curious-particle-network"
    title={pageData.hero.tagline}
    subtitle={pageData.hero.subtitle}
    showActions={false}
    accountForNavigation={true}
    accountForBreadcrumbs={false}
    isIndexPage={true}
  />

  <!-- Intro Section -->
  <Section title={pageData.intro.title} intro={pageData.intro.content}>
    <blockquote class="border-primary bg-card border-l-4 p-6 italic">
      <div
        class="text-foreground text-lg leading-7"
        set:html={marked.parse(pageData.intro.magicWandQuestion)}
      />
    </blockquote>
  </Section>

  <!-- What We Offer Section -->
  <Section title={pageData.whatWeOffer.title}>
    <div class="grid gap-8 lg:grid-cols-3">
      {
        pageData.whatWeOffer.services.map((service: any) => (
          <div class="comic-panel">
            <h3 class="font-heading text-foreground mb-4 text-xl font-bold tracking-tight">
              {service.title}
            </h3>
            <p class="text-muted-foreground leading-7">{service.description}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Why Bracket Bear Section -->
  <Section title={pageData.whyBracketBear.title}>
    <div class="grid gap-8 lg:grid-cols-2">
      {
        pageData.whyBracketBear.values.map((value: any) => (
          <div class="comic-panel">
            <h3 class="font-heading text-foreground mb-4 text-xl font-bold tracking-tight">
              {value.title}
            </h3>
            <div
              class="text-muted-foreground prose prose-lg max-w-none"
              set:html={marked.parse(value.description)}
            />
          </div>
        ))
      }
    </div>
  </Section>

  <!-- CTA Section -->
  <section class="px-content py-12 lg:py-16">
    <div class="container mx-auto text-center">
      <div class="prose prose-lg mx-auto max-w-prose">
        <div
          class="text-foreground mb-8 text-lg leading-7"
          set:html={marked.parse(pageData.contactCTA.text)}
        />
        <Button
          href={pageData.contactCTA.buttonLink}
          size="lg"
          className="font-semibold"
        >
          {pageData.contactCTA.buttonText}
        </Button>
      </div>
    </div>
  </section>
</HomeLayout>
