---
// The run club page is a single public landing page for one event, so it
// skips Layout.astro the way lab.astro does: no site nav, no contact form,
// no pointer effects. The flyer's QR code and the LinkedIn post point here.
import '@/styles/run.css';
import RunMap from '@/components/run/RunMap';

const title = 'Bracket Bear Run Club — SEGD 2026, Kansas City';
const description =
  'Friday, October 23, 7:00 a.m. 5.5K from the Kansas City Marriott Downtown to the Liberty Memorial and back before the first session. Every pace.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://bracketbear.com/run" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://bracketbear.com/run" />
    <meta property="og:image" content="https://bracketbear.com/run/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#110a08" />
  </head>
  <body class="bb-run">
    <main class="run">
      <header class="run__head">
        <a
          class="run__mark"
          href="https://bracketbear.com"
          aria-label="Bracket Bear"
        >
          <svg
            viewBox="159 130 1241 300"
            role="img"
            aria-label="Bracket Bear Run Club"
          >
            <g transform="translate(159,155)">
              <path
                d="m69.98,172.24v-94.76c0-4.14,3.36-7.5,7.5-7.5h15.14c1.66,0,3-1.34,3-3V3C95.62,1.34,94.28,0,92.62,0H15C6.72,0,0,6.72,0,15v219.73c0,8.28,6.72,15,15,15h77.62c1.66,0,3-1.34,3-3v-63.99c0-1.66-1.34-3-3-3h-15.14c-4.14,0-7.5-3.36-7.5-7.5Z"
              ></path>
              <path
                fill-rule="evenodd"
                d="m174.98,117.27c12.14,16.38,20.1,28.95,19.83,56.54-.73,66.7-62.49,74.8-77.35,75.78-1.73.11-3.19-1.26-3.19-2.99v-84.29c0-1.66-1.34-3-3-3h-19.68c-1.66,0-3-1.34-3-3v-64.05c0-1.66,1.34-3,3-3h19.68c1.66,0,3-1.34,3-3V3.05c0-1.72,1.44-3.08,3.16-3,12.12.59,55.68,6.48,69.61,59.96,7.61,29.23-3.42,50.36-12.06,57.26"
              ></path>
              <path
                d="m323.41,179.74h-15.14c-1.66,0-3,1.34-3,3v63.99c0,1.66,1.34,3,3,3h77.62c8.28,0,15-6.72,15-15V15C400.89,6.72,394.18,0,385.89,0h-77.62c-1.66,0-3,1.34-3,3v63.99c0,1.66,1.34,3,3,3h15.14c4.14,0,7.5,3.36,7.5,7.5v94.76c0,4.14-3.36,7.5-7.5,7.5Z"
              ></path>
              <path
                fill-rule="evenodd"
                d="m225.92,117.28c-8.64-6.9-19.67-28.03-12.06-57.26C227.79,6.53,271.35.64,283.47.05c1.72-.08,3.16,1.28,3.16,3v83.21c0,1.66,1.34,3,3,3h19.68c1.66,0,3,1.34,3,3v64.05c0,1.66-1.34,3-3,3h-19.68c-1.66,0-3,1.34-3,3v84.29c0,1.73-1.46,3.11-3.19,2.99-14.86-.98-76.62-9.08-77.35-75.78-.27-27.6,7.69-40.17,19.83-56.54"
              ></path>
            </g>
            <rect x="635" y="155" width="10" height="250"></rect>
            <text x="685" y="211" textLength="715" class="run__mark-wordmark"
              >BRACKET BEAR</text
            >
            <text x="681" y="405" class="run__mark-display">RUN CLUB</text>
          </svg>
        </a>
        <p class="run__eyebrow">SEGD 2026 · Kansas City</p>
      </header>

      <section class="run__hero">
        <div class="run__hero-text">
          <h1 class="run__when">
            <span>Friday</span>
            <span>Oct 23</span>
            <span>7:00 am</span>
          </h1>
          <p class="run__where">
            Kansas City Marriott Downtown<br />meet in the lobby
          </p>
          <p class="run__what">
            5.5K out to the Liberty Memorial and back. Every pace.
          </p>
          <div class="run__actions">
            <a
              class="run__button"
              href="/run/run.ics"
              download="bracket-bear-run-club.ics">Add to calendar</a
            >
            <a
              class="run__button run__button--quiet"
              href="https://maps.apple.com/?q=Kansas+City+Marriott+Downtown"
              target="_blank"
              rel="noopener">Open the map</a
            >
          </div>
        </div>
        <!-- Downtown Kansas City from OpenStreetMap, the route from Valhalla's
             pedestrian routing, baked once into the animations package. The
             still is the server-rendered fallback; the island draws the
             route over it. The page loads no map service. -->
        <figure class="run__figure">
          <div class="run__map">
            <img
              class="run__poster"
              src="/run/map.png"
              width="900"
              height="1100"
              alt="Map of downtown Kansas City with the route traced: from the Marriott down Wyandotte to Union Station, up to the Liberty Memorial, and back."
            />
            <RunMap client:only="react" />
          </div>
          <figcaption class="run__caption">
            <span>Marriott · start</span>
            <span>Liberty Memorial · turn</span>
          </figcaption>
        </figure>
      </section>

      <section class="run__body">
        <p>
          Friday morning at SEGD, before the first session, we run. Out of the
          Marriott lobby, down Wyandotte past the Kauffman Center to Union
          Station, up the hill to the Liberty Memorial for the skyline, and back
          the same way. 5.5K, two climbs, at whatever pace the group turns out
          to be. Walkers welcome. Nobody gets left on the course.
        </p>
        <p>
          No sign-up. Be in the lobby at 7:00 and we leave together. Hotel
          coffee is on the other side of it.
        </p>
        <p>
          Bracket Bear rebuilds the platform layer behind experiential work.
          Rooted in Pittsburgh, based in Portland, in Kansas City all week for
          SEGD. If you want to talk shop, the run is a good place to start.
        </p>
      </section>

      <footer class="run__foot">
        <p class="run__welcome">
          Welcome to Bracket Bear.<br />We're happy to have you.
        </p>
        <a class="run__site" href="https://bracketbear.com">bracketbear.com</a>
        <p class="run__credit">Map data © OpenStreetMap contributors</p>
      </footer>
    </main>
  </body>
</html>
