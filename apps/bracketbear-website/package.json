{
  "name": "@bracketbear/bracketbear-website",
  "type": "module",
  "version": "1.0.1",
  "description": "Main company website for Bracket Bear, built with Astro and integrated CMS",
  "scripts": {
    "dev": "astro dev --host --port 4321",
    "prebuild": "node ../../scripts/generate-repo-map.js && node ../../scripts/update-main-readme.js",
    "build": "astro build",
    "preview": "astro preview --host --port 4321",
    "astro": "astro",
    "type-check": "tsc --noEmit",
    "deploy": "netlify deploy --prod"
  },
  "dependencies": {
    "@astrojs/markdoc": "^0.13.3",
    "@astrojs/react": "^4.2.3",
    "@bracketbear/astro-content": "file:../../packages/astro-content",
    "@bracketbear/bear-ui-react": "file:../../packages/bear-ui-react",
    "@bracketbear/bear-ui-tailwind": "file:../../packages/bear-ui-tailwind",
    "@bracketbear/core": "file:../../packages/core",
    "@bracketbear/flateralus": "file:../../packages/flateralus",
    "@bracketbear/flateralus-pixi": "file:../../packages/flateralus-pixi",
    "@bracketbear/flateralus-pixi-animations": "file:../../packages/flateralus-pixi-animations",
    "@bracketbear/flateralus-react": "file:../../packages/flateralus-react",
    "@fontsource/anton": "^5.2.7",
    "@fontsource/archivo-black": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "astro": "^5.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "vite-plugin-svgr": "^4.3.0"
  }
}
