{
  "version": "2.0.0",
  // Astro 7 requires Node >= 22.12; task shells don't load nvm, so pin it here (see .nvmrc)
  "options": {
    "env": {
      "PATH": "${env:HOME}/.nvm/versions/node/v22.22.2/bin:${env:PATH}"
    }
  },
  "tasks": [
    // ── Install ──────────────────────────────────────────────
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "npm install",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev-setup"
      },
      "problemMatcher": []
    },

    // ── UI Packages ──────────────────────────────────────────
    {
      "label": "Dev: bear-ui",
      "type": "shell",
      "command": "npm run dev --workspace=@bracketbear/bear-ui",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "packages"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev: bear-ui-tailwind",
      "type": "shell",
      "command": "npm run dev --workspace=@bracketbear/bear-ui-tailwind",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "packages"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev: bear-ui-react",
      "type": "shell",
      "command": "npm run dev --workspace=@bracketbear/bear-ui-react",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "packages"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev: core",
      "type": "shell",
      "command": "npm run dev --workspace=@bracketbear/core",
      "isBackground": true,
