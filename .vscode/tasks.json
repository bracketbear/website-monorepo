        "reveal": "always",
        "panel": "dedicated",
        "group": "packages"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev: schemas",
      "type": "shell",
      "command": "npm run dev --workspace=@bracketbear/schemas",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "packages"
      },
      "problemMatcher": []
    },

