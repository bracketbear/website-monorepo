    // ── Compound Tasks ───────────────────────────────────────
    {
      "label": "Start All Dev Servers",
      "dependsOn": [
        "Dev: bear-ui",
        "Dev: bear-ui-tailwind",
        "Dev: bear-ui-react",
        "Dev: core",
        "Dev: schemas",
        "Dev: flateralus",
        "Dev: flateralus-pixi",
        "Dev: flateralus-p5",
        "Dev: flateralus-pixi-animations",
        "Dev: flateralus-p5-animations",
        "Dev: flateralus-react",
        "Dev: CMS",
        "Dev: Bracket Bear Website",
        "Dev: Portfolio"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Full Dev Setup (Install + Start)",
      "dependsOn": ["Install Dependencies", "Start All Dev Servers"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
